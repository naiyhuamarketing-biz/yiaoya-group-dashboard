# Yiaoya Group — Ads Dashboard
# Copy this to .env locally; in Render set the same keys via dashboard env vars.

# ── Facebook Marketing API ──────────────────────────
# Long-lived (60-day) token; auto-extends every API call (kept alive by keepalive workflow)
FB_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=

# Ad Account IDs are hardcoded in lib/yiaoya_accounts.py (5 active accounts).
# No FB_ACCOUNT_* env var needed — multi-account loader iterates the registry.

# ── Optional ────────────────────────────────────────
TZ=Asia/Bangkok
